# Build output
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# Web
node_modules/
web/build/
web/.svelte-kit/
# The embedded UI is generated by `make web`; only the placeholder is committed.
server/internal/webui/dist/*
!server/internal/webui/dist/placeholder.html

# Prototype build output (the committed single-file build is tuskline-prototype.html)
prototype/dist/
prototype/dist-single/
prototype/*.tsbuildinfo

# moon (task cache, generated Docker and hook files)
.moon/cache/
.moon/docker/

# Local state and secrets
.env
.env.*
!.env.example
*.sqlite
*.sqlite-*
*.db
/tmp/

# Editors and OS
.idea/
*.swp
.DS_Store
Thumbs.db
